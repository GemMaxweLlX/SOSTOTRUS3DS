{
 "file": "SimpleTalk_S_Craftman",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "d28e6d76",
   "ru": "Мне нехорошо."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "0360a427",
   "ru": "Хм? Что такое? Чем помочь?"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "094572e6",
   "ru": "Ветер сегодня сильный."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "5635263d",
   "ru": "Сегодня держись подальше от берега."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "55831a20",
   "ru": "Я слишком много работал."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "11f89dfd",
   "ru": "*вздох* Я выжат."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "3b81098c",
   "ru": "Голова сегодня болит."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "218ac44e",
   "ru": "Алоха. Сегодня мне хорошо."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "7db6f867",
   "ru": "Какой чудесный день."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "281d8e01",
   "ru": "Если что-то нужно, только попроси."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "1eabe7dd",
   "ru": "Эй, поболтаем немного?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "0a1230c2",
   "ru": "Как поживаете?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "51c95832",
   "ru": "У тебя какие-то трудности?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "864201e0",
   "ru": "Как ферма?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "4673f36b",
   "ru": "Рад, что у тебя всё хорошо."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "e03b67e7",
   "ru": "Эй, трудишься? Так держать."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "56b66f98",
   "ru": "Не бегай так. Споткнёшься."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "9609e023",
   "ru": "Есть хочется, наверное?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "c5ba699f",
   "ru": "Похоже, тебе сегодня весело."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "d60c6cd9",
   "ru": "Не перетруждайся."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "d60c6cd9",
   "ru": "Не перетруждайся."
  }
 ]
}
