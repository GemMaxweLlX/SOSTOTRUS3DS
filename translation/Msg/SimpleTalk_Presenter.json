{
 "file": "SimpleTalk_Presenter",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "a2ba9c50",
   "ru": "Ох. Голова кружится..."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "45d92a75",
   "ru": "Добро пожаловать! Чем могу помочь?"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "d0ed8af9",
   "ru": "Ну и буря, а?"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "09821cfa",
   "ru": "Снег сегодня так и валит."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "5809202c",
   "ru": "Я немного выдохся..."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "902434a6",
   "ru": "Уф, что-то я раскис."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "0f8a405e",
   "ru": "Сейчас рухну от усталости."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "7ad260d9",
   "ru": "Хе-хе! Мне потрясающе!"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "3b24920d",
   "ru": "Отлично! Начинаем шоу!"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "c3458a20",
   "ru": "Ура! Сегодня будет потрясающе!"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "084dcae2",
   "ru": "Ведущему вроде меня нужна улыбка победителя."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "9b9cef89",
   "ru": "Я всегда берегу горло."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "88320784",
   "ru": "Приветик! Как дела?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "d9303026",
   "ru": "Чудесное место."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "c9c8bf39",
   "ru": "На следующем мероприятии я всех порву!"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "ba10d7bb",
   "ru": "Сегодня мне отлично."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "9bde19ca",
   "ru": "Цвет моей ауры ― розовый, знаешь ли."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "3e05147c",
   "ru": "Мало что радует так, как вкусная еда."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "bda404b5",
   "ru": "Мне всегда приятно с кем-то поздороваться."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "3da2fa29",
   "ru": "Надеюсь, день выйдет весёлым."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "136af91b",
   "ru": "Привет, приятно познакомиться."
  }
 ]
}
