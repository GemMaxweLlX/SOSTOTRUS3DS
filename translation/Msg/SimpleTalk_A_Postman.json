{
 "file": "SimpleTalk_A_Postman",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "73e3281e",
   "ru": "Чёрт... Еле шевелюсь."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "c3e54109",
   "ru": "Давай-ка оба выложимся на работе."
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "4c9b80f3",
   "ru": "Ветер воет, как влюблённый кот."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "7c173e51",
   "ru": "Снег так и валит."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "1826b4ef",
   "ru": "Уф..."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "8b9636f9",
   "ru": "Голова раскалывается."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "6210997d",
   "ru": "Видно, не выспался."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "76a2fbd0",
   "ru": "Сегодня я готов взять быка за рога."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "3b9f09a9",
   "ru": "Сегодня мне чертовски хорошо."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "09ea9ec9",
   "ru": "Насвистеть тебе весёлую мелодию?"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "f23d0dca",
   "ru": "Красивая у тебя улыбка, знаешь?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "f018abdc",
   "ru": "Привет. Как у тебя дела?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "74c76656",
   "ru": "Здорово, <_____MYNAME_____>."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "36070246",
   "ru": "Отличный сегодня денёк, а?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "9a84f544",
   "ru": "Хочется с кем-нибудь поболтать. Как насчёт?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "eb422aa8",
   "ru": "Ох, гляди, сколько времени."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "7dadf178",
   "ru": "Отлично выглядишь сегодня."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "8d3f1802",
   "ru": "О, <_____MYNAME_____>."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "78696f2e",
   "ru": "Надо разнести ещё пару писем."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "8d0d3268",
   "ru": "Я всегда за тебя болею."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "8d0d3268",
   "ru": "Я всегда за тебя болею."
  }
 ]
}
