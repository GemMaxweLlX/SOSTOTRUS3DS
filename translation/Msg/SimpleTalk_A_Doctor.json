{
 "file": "SimpleTalk_A_Doctor",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "b26eb898",
   "ru": "Ох... Тело совсем не хочет двигаться."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "843660fc",
   "ru": "Что случилось? Плохо себя чувствуешь?"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "4c50780e",
   "ru": "Сегодня выходить на улицу опасно."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "a560747b",
   "ru": "Сегодня довольно холодно."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "5c8d232b",
   "ru": "Болит голова. Это недопустимо."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "3f4c04b9",
   "ru": "Сил маловато, если честно."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "ef986bb5",
   "ru": "Сейчас я не совсем в форме."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "757e6755",
   "ru": "Сегодня я в превосходной форме."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "fb4221d7",
   "ru": "Мне только что пришла блестящая идея."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "74e62b2d",
   "ru": "Не знаю почему, но сегодня мне отлично."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "1105d7b4",
   "ru": "Тебе что-то от меня нужно?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "00317f1f",
   "ru": "Энергии у тебя хоть отбавляй."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "158cf890",
   "ru": "Пожалуйста, не поднимай пыль."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "8d4efd66",
   "ru": "Ты точно нормально питаешься?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "7f5a5bf0",
   "ru": "Осторожнее. Мне не нужно лишней работы."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "31eb0b55",
   "ru": "Береги себя."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "5d8f6a2e",
   "ru": "Ты прямо воплощение здоровья."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "5f2c5cad",
   "ru": "Рад видеть, что ты при деле."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "732d8580",
   "ru": "А, это <_____MYNAME_____>."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "9ca1b35f",
   "ru": "Смотри под ноги."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "12242293",
   "ru": "Смотри под ноги."
  }
 ]
}
