{
 "file": "SimpleTalk_J_StuffWoman",
 "entries": [
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "5d54e742",
   "ru": "Спасибо, что заглянули."
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "e59f9796",
   "ru": "Батюшки! Да вы насквозь промокли."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "9e2306a5",
   "ru": "Вы пришли сюда в такую погоду?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "f502d4db",
   "ru": "Я сегодня немного устала."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "b3ab904c",
   "ru": "У меня болит голова."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "cc534b9b",
   "ru": "Может, в другой раз."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "0fb72b64",
   "ru": "Хе-хе, мне сегодня хорошо."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "7e14d682",
   "ru": "Сегодня мне хочется поболтать."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "20a25f82",
   "ru": "Сегодня будет хороший день."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "10114829",
   "ru": "Рада, что вам весело."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "e3900d5a",
   "ru": "Похоже, на ферме у вас всё хорошо."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "8c529575",
   "ru": "Не спешите и не перетруждайтесь."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "4ace96b6",
   "ru": "Вы такой трудолюбивый человек."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "c92bc97b",
   "ru": "Трудитесь?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "81526a20",
   "ru": "Может, пойти нарвать цветов."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "e2f54ef3",
   "ru": "Куда вы сегодня?"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "f9f81873",
   "ru": "Вы сегодня за покупками?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "1107859a",
   "ru": "Вы хорошо питаетесь?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "a47134f8",
   "ru": "Мы с семьёй рады знакомству с вами."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "bd3fe81a",
   "ru": "О, здравствуйте. А вы кто будете?"
  }
 ]
}
