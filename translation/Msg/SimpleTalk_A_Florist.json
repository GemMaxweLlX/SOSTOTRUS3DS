{
 "file": "SimpleTalk_A_Florist",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "6f5ed08e",
   "ru": "Болеть ― это так неприятно."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "adb3f183",
   "ru": "О, добро пожаловать!"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "7b88184f",
   "ru": "Льёт как из ведра."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "5a77392e",
   "ru": "Снег не утихает. Я немного волнуюсь."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "4538315a",
   "ru": "Уф. Что со мной такое?"
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "a74010e1",
   "ru": "Мне сейчас не очень хорошо."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "5c731afb",
   "ru": "Я устала...?"
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "1a27ffee",
   "ru": "Хи-хи. Мне так радостно."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "d16c475c",
   "ru": "Чудесный денёк, правда?"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "242aa847",
   "ru": "Пусть эта радость длится вечно."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "da1fd0d5",
   "ru": "Я так хотела с тобой поговорить!"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "ebcbf6b0",
   "ru": "Давай сегодня оба выложимся! ♪"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "2966af62",
   "ru": "Может, поболтаем немного?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "ba1eb28f",
   "ru": "Отлично сегодня выглядишь."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "2c6ef00d",
   "ru": "Надеюсь, тебе так же хорошо, как мне."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "ba3be3aa",
   "ru": "Ой, смотри под ноги, не споткнись."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "f7fcf821",
   "ru": "Хи-хи. Твоя улыбка как лучик солнца."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "4b923541",
   "ru": "А ты знаешь, что цветы цветут круглый год?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "e5abeb1f",
   "ru": "Хи-хи, ты всегда такой энергичный человек."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "fb1dab23",
   "ru": "Сегодня у тебя был трудовой день!"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "fb1dab23",
   "ru": "Сегодня у тебя был трудовой день!"
  }
 ]
}
