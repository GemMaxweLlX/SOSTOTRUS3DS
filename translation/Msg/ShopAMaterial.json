  {
   "n": 7,
   "f": 2,
   "id": "MSG_SHOP_MATERIAL_CHOICE_001",
   "key": "9d01a9f9",
   "ru": "<NAME_MOB_HIRAF>\r\nЧто-нибудь ещё?"
