{
 "file": "SimpleTalk_S_TwinYounger",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "2acd8f8a",
   "ru": "Ох... Голова болит."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "7b0e396f",
   "ru": "Мне велели говорить: “Комо май”."
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "b912da0c",
   "ru": "Сейчас выходить опасно."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "9dee6eae",
   "ru": "Советую сидеть дома."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "f2170c0f",
   "ru": "Уф."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "af1a11cf",
   "ru": "Я устала..."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "ad713e70",
   "ru": "Мне сегодня нехорошо... кажется."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "0c8788a9",
   "ru": "Сегодня хороший день."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "9fa49a04",
   "ru": "Мне хорошо."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "db608c56",
   "ru": "Голова сегодня ясная."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "b61fd731",
   "ru": "Спать хочу."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "acb5c8c2",
   "ru": "Алоха."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "222df61f",
   "ru": "Ого. Неожиданно."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "ccd7803b",
   "ru": "Знаешь какие-нибудь редкие дикие растения?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "1d8e25ed",
   "ru": "А твоя ферма...? А, понятно."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "0927a34c",
   "ru": "Похоже, тебе весело."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "74abcfc6",
   "ru": "Хочешь немного поговорить?"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "c0c5e39b",
   "ru": "Береги себя."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "3e557ab2",
   "ru": "Есть хочешь?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "691872b6",
   "ru": "...Ой, э кала май. Прости, задумалась."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "691872b6",
   "ru": "...Ой, э кала май. Прости, задумалась."
  }
 ]
}
