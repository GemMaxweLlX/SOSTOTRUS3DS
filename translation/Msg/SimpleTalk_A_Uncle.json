{
 "file": "SimpleTalk_A_Uncle",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "9dc592d8",
   "ru": "Я бы сегодня посидел дома."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "4896f55d",
   "ru": "Ух ты. На улице, должно быть, мороз."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "e416b28b",
   "ru": "Что-то я сегодня неважно."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "668e10b0",
   "ru": "Пожалуй, надо отдохнуть."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "b66eb493",
   "ru": "Что-то вдруг совсем вымотался."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "fba9204a",
   "ru": "Сегодня мне отлично."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "1bab3d6d",
   "ru": "Прямо сейчас мне очень хорошо."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "cc722594",
   "ru": "У меня сегодня всё ладится. А у тебя?"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "6acbbae8",
   "ru": "Пробуй как можно больше нового."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "6511dba6",
   "ru": "Куда направляешься?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "72dae2cb",
   "ru": "Эй, рад тебя видеть!"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "5c4f847f",
   "ru": "Трудишься?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "dd85f9b8",
   "ru": "О, как дела?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "8986915d",
   "ru": "На ферме всё ладится?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "f0c73b88",
   "ru": "Удачи в работе!"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "69259f2a",
   "ru": "Эй, <_____MYNAME_____>!"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "6e868b0d",
   "ru": "Полезно глянуть, как работают другие фермеры."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "512e3af6",
   "ru": "Задора тебе не занимать."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "f7b991bd",
   "ru": "Попробовать новое никогда не вредно."
  }
 ]
}
