{
 "file": "SimpleTalk_J_Inari",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "48908d3b",
   "ru": "Сегодня выходить небезопасно."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "d45ad32f",
   "ru": "Смотри не замёрзни, хорошо?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "c5f54049",
   "ru": "Со мной что-то не так..."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "9d4d9b84",
   "ru": "Кажется, я немного устала."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "df62ceb2",
   "ru": "Сегодня во мне нет сил..."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "62c20b1e",
   "ru": "Сегодня я хорошо себя чувствую."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "c70b5069",
   "ru": "Сегодня я чувствую себя превосходно."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "4ddd284a",
   "ru": "Так вот что значит “доброе здоровье”."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "ec2b1058",
   "ru": "Мне нравится твоя улыбка. Тёплая."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "effe7c6f",
   "ru": "Ты и правда большой трудяга."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "07616eaa",
   "ru": "Что это на тебе? Кажется, обновка."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "ecc44e53",
   "ru": "Ты хорошо о себе заботишься?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "736582c3",
   "ru": "Что-то случилось?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "9b2f2963",
   "ru": "Если беда, можешь мне рассказать."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "9227a04c",
   "ru": "Бегать можно, только не споткнись..."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "7db698dc",
   "ru": "Мне нужно очистить тело и разум."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "de07fe49",
   "ru": "Может, сыграем со мной в кэмари?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "b471f00c",
   "ru": "А этот “футбол” ― интересная игра?"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "6cbd3766",
   "ru": "Что случилось?"
  }
 ]
}
