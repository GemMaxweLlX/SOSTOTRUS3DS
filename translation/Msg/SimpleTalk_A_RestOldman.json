{
 "file": "SimpleTalk_A_RestOldman",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "a77e537a",
   "ru": "Смотри, чтобы ветром не унесло!"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "99232103",
   "ru": "Батюшки. На улице, должно быть, мороз."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "bc2ebd03",
   "ru": "Сегодня я немного устал."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "00680829",
   "ru": "Сегодня мне нездоровится."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "b1c2fbe4",
   "ru": "Ой..."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "dfc3396c",
   "ru": "Сегодня я чувствую себя на миллион!"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "6e22a2a0",
   "ru": "Мне ещё многому учиться."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "552ddecd",
   "ru": "Я ещё не собираюсь на покой!"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "ddf93208",
   "ru": "Ты всегда такой бодрый человек."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "3ab8d778",
   "ru": "Нравится мне твоя улыбка. Честная."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "e8a82b16",
   "ru": "Много трудишься, да?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "3c519161",
   "ru": "Смотри под ноги."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "a6db145d",
   "ru": "Ох, хочется вкусной рыбки."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "fb98a3fe",
   "ru": "У тебя ведь нет никаких неприятностей?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "289c1034",
   "ru": "Нужна помощь ― всегда обращайся."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "fd60e971",
   "ru": "Есть минутка-другая поболтать?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "511a0d7b",
   "ru": "Ах, молодость ― истинное сокровище."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "8de9e0b6",
   "ru": "Как насчёт поесть в моём ресторане?"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "2ef49c22",
   "ru": "Ну-ка, а ты кто будешь?"
  }
 ]
}
