{
 "file": "SimpleTalk_J_StuffMan",
 "entries": [
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "b78fdea1",
   "ru": "Спасибо, что пришли."
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "0a327638",
   "ru": "Спасибо, что пришли в такую погоду."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "05a978a6",
   "ru": "Вы не замёрзли?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "421075c1",
   "ru": "Сегодня у меня неудачный день."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "4c4a19eb",
   "ru": "Простите, но оставьте меня, пожалуйста."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "b7d82288",
   "ru": "Простите, мне сегодня нехорошо."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "1f11cddc",
   "ru": "Предчувствие у меня сегодня хорошее."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "e41adb88",
   "ru": "Работа хорошо продвигается."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "618e4a21",
   "ru": "Для разнообразия мне отлично."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "0a1230c2",
   "ru": "Как поживаете?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "ce570c71",
   "ru": "Вы хорошо выглядите."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "8fb5e926",
   "ru": "Вам что-то нужно?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "0a64e69d",
   "ru": "Похоже, вы всё время работаете."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "9b3c8d79",
   "ru": "Если что-то нужно, просто скажите."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "ff6e6f1c",
   "ru": "Можно потише?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "41ae45f4",
   "ru": "Никогда не видел такого наряда."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "d19a6cf0",
   "ru": "Разве вам не пора работать?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "82626b6e",
   "ru": "Простите, что я всегда так прямолинеен."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "259ea2eb",
   "ru": "Вам нужна Сидзу?"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "b11f2c30",
   "ru": "О, здравствуйте."
  }
 ]
}
