   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "4e3c283c",
   "ru": "Ого... Т-ты видишь молнию?"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "37532929",
   "ru": "Тут можно слепить миллион снежков..."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "9190e08e",
   "ru": "*кхе-кхе*"
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "966f4b78",
   "ru": "Спать хочется."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "47381979",
   "ru": "Я устал."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "328320ae",
   "ru": "Хи-хи. Сегодня отличный день."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "225dfe5b",
   "ru": "Сегодня так весело."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "1d177e8b",
   "ru": "Мне даже лучше, чем обычно."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "af019584",
   "ru": "...Что случилось?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "b95fe021",
   "ru": "...Что ты делаешь?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "cdcc1aef",
   "ru": "Ой, вот это неожиданно..."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "ffa5bc78",
   "ru": "Эм... Привет."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "106e00f9",
   "ru": "Хорошего тебе дня."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "c6e4a040",
   "ru": "...Хочешь порисовать со мной?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "2547cbb4",
   "ru": "Эм... Никогда не знаю, что сказать..."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "6972d1bf",
   "ru": "Тут бегать опасно."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "a9cfadf1",
   "ru": "...Ладно, неважно."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "e66d6af0",
   "ru": "Привет, <_____MYNAME_____>."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "a5731018",
   "ru": "Эм... Мы раньше встречались?"
  }
 ]
}
