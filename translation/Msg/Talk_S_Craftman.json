  {
   "n": 396,
   "f": 2,
   "id": "MES_LOVE_CANCEL_01",
   "key": "67c6431b",
   "ru": "<FACE_CRAFTMAN><POS_RIGHT><FACE_NORMAL>\r\nДа. Да, пожалуй, стоит. Может, пойдём к\nтебе?"
  },
  {
