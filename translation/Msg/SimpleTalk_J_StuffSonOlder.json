{
 "file": "SimpleTalk_J_StuffSonOlder",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "8fb426a1",
   "ru": "Ненавижу гром."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "88293b7d",
   "ru": "Ого, как льёт."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "76b47792",
   "ru": "Мне никак не везёт."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "31c49b3b",
   "ru": "*вздох* Привет."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "11746e81",
   "ru": "Почему я такой невезучий?"
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "813777be",
   "ru": "Сегодня мне хорошо."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "ef7fd372",
   "ru": "Не верится, что совсем не хочу спать."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "f4f77992",
   "ru": "Сегодня будет хороший день!"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "2a4c6f0c",
   "ru": "Давай не торопиться."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "276d91d7",
   "ru": "Ты всё время куда-то бегаешь, а?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "0d95d1c7",
   "ru": "Привет."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "b370ccb6",
   "ru": "Главное в жизни ― не напрягаться."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "dcc3a179",
   "ru": "Сил у тебя всегда полно."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "facce1ab",
   "ru": "Можно мне скоро заглянуть к тебе на ферму?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "38f68dd0",
   "ru": "Куда ты так спешишь?"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "aa5e49a8",
   "ru": "Поговори со мной чуть-чуть."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "a38acd75",
   "ru": "Спать хочется."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "bddbb340",
   "ru": "Я что-то устал."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "2264f265",
   "ru": "Мы ведь раньше не встречались?"
  }
 ]
}
