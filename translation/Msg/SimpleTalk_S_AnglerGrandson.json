  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "afde44c5",
   "ru": "Осторожнее по дороге домой."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
