   "f": 2,
   "id": "MSG_SHOP_FOODSTUFF_CHOICE_000",
   "key": "eb210892",
   "ru": "<FACE_FISHERWIFE><POS_RIGHT><FACE_NORMAL>\r\nЧем помочь?"
