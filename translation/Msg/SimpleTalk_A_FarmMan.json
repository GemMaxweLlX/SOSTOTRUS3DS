{
 "file": "SimpleTalk_A_FarmMan",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "08c9d10f",
   "ru": "Не люблю я тайфуны."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "8563430f",
   "ru": "Ну и снегу навалило."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "38b425b1",
   "ru": "Что-то мне сегодня нехорошо."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "b51abfdb",
   "ru": "Устал я."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "5950eed9",
   "ru": "Оставь меня, пожалуйста."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "a09dd8c8",
   "ru": "Сегодня хорошо себя чувствую."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "636b2bb7",
   "ru": "Я похож на довольного?"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "ad84b272",
   "ru": "Неплохой сегодня денёк."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "74c76656",
   "ru": "Здорово, <_____MYNAME_____>."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "c43fea3c",
   "ru": "...Тихо тут и спокойно."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "1a43b61b",
   "ru": "..."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "f96e5aa5",
   "ru": "Задора тебе не занимать."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "e52390f7",
   "ru": "Я не мастер болтать."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "2f64854e",
   "ru": "Что ты делаешь в таком месте?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "28a37325",
   "ru": "Неужто со мной так интересно говорить?"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "ea11e5fb",
   "ru": "Не будешь смотреть под ноги ― споткнёшься."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "fddd95ba",
   "ru": "Разговоры ― не мой конёк."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "a62bf4c1",
   "ru": "Похоже, сегодня работа кипела."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "0dd7b746",
   "ru": "...Что-то я тебя раньше не видел."
  }
 ]
}
