   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "26f3666c",
   "ru": "Батюшки, гулять в такую погоду?"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "f4557238",
   "ru": "Нечего гулять в такой день."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "96c5782d",
   "ru": "Уф... Немного устал."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "a495b7cb",
   "ru": "Видно, и правда старею."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "a78fc7e4",
   "ru": "Пойду отдохну."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "317e786c",
   "ru": "Сегодня хорошо себя чувствую."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "33f99b72",
   "ru": "Я ещё не ТАК стар."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "17d541aa",
   "ru": "Я в самом расцвете сил!"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "66650c4a",
   "ru": "Сил у тебя хоть отбавляй."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "edcf4094",
   "ru": "Смотри, куда идёшь."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "09a5c67e",
   "ru": "Иногда полезно передохнуть."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "15dfd607",
   "ru": "Похоже, у тебя сейчас много дел."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "939248a3",
   "ru": "Как продвигается ферма?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "816e2ead",
   "ru": "Спрашивай что угодно о выращивании урожая."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "d4d4bd76",
   "ru": "Надеюсь, ты подружишься с Юдзуки."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "9f59802b",
   "ru": "Одевайся теплее и хорошо ешь, ладно?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "e1f6ad59",
   "ru": "Есть время поговорить со мной?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "8a5c26ba",
   "ru": "Я тебе нужен?"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "8a4b1f76",
   "ru": "А ты, случаем, не...?"
  }
 ]
}
