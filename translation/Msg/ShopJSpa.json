{
 "file": "ShopJSpa",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_000",
   "key": "afce0d5b",
   "ru": "Клиника закрыта до конца праздника."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_001",
   "key": "eec4b96f",
   "ru": "Сегодня заведение уже закрыто."
  },
  {
   "n": 2,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_002",
   "key": "56bfda77",
   "ru": "Купальня закрыта. Приходите в часы работы."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_003",
   "key": "5c346323",
   "ru": "<NAME_MOB_MUTSU>\r\nДобро пожаловать в чудесно расслабляющую\nкупальню “Кипарисовая ванна”!\n<PAGE>\nБлагодаря твоей помощи наши купели снова\nполны целебной воды.\n<PAGE>\nЦены у нас лучше некуда, приходи почаще."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_004",
   "key": "b5033276",
   "ru": "<NAME_MOB_MUTSU>\r\nДобро пожаловать в чудесно расслабляющую\nкупальню “Кипарисовая ванна”!"
  },
  {
   "n": 5,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GREETING_005",
   "key": "89fc39fc",
   "ru": "Только сейчас у нас особая купель, созданная с\nтвоей помощью, обязательно попробуй!"
  },
  {
   "n": 6,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_CHOICE_000",
   "key": "3c963d77",
   "ru": "<NAME_MOB_MUTSU>\r\nПозволь предложить окунуться в наши\nпрекрасные горячие источники. Все заботы\nпросто растворятся."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_CHOICE_001",
   "key": "c62cc0c2",
   "ru": "Принять ванну"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_CHOICE_002",
   "key": "6741ab03",
   "ru": "Работа"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_CHOICE_003",
   "key": "a39a6a22",
   "ru": "Спросить о совместной работе"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_CHOICE_004",
   "key": "69241676",
   "ru": "<CANCEL_SELECT>\r\nПока не буду"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_000",
   "key": "063aae88",
   "ru": "<NAME_MOB_MUTSU>\r\nВыбери купель."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_001",
   "key": "57127d55",
   "ru": "Сосновая (<BLUE><MOJI0></BLUE>G)"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_002",
   "key": "af49b939",
   "ru": "Бамбуковая (<BLUE><MOJI1></BLUE>G)"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_003",
   "key": "b4d8d650",
   "ru": "Сливовая (<BLUE><MOJI2></BLUE>G)"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_004",
   "key": "673e447b",
   "ru": "Суперлюкс (<BLUE><MOJI3></BLUE>G)"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_005",
   "key": "69241676",
   "ru": "<CANCEL_SELECT>\r\nПока не буду"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_HIGH_000",
   "key": "dc798c5f",
   "ru": "<NAME_MOB_MUTSU>\r\nВ сосновой купели есть мочалка и массажёр, а\nвода чистейшая, в купальне из кипариса."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_MIDDLE_000",
   "key": "d9cea3ff",
   "ru": "<NAME_MOB_MUTSU>\r\nА, бамбуковая! Там тоже есть щётка и\nмассажёр."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_LOW_000",
   "key": "b668a95b",
   "ru": "<NAME_MOB_MUTSU>\r\nДа, сливовая. Если хочется просто отдохнуть в\nгорячей минеральной воде, это лучший выбор."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_00_000",
   "key": "a1463a8b",
   "ru": "<NAME_MOB_MUTSU>\r\nО-хо! Суперлюкс!\n<PAGE>\nСегодня это самая настоящая винная ванна.\nТепло расслабит и душу, и мышцы!"
  },
  {
   "n": 21,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_01_000",
   "key": "90e1b2e4",
   "ru": "<NAME_MOB_MUTSU>\r\nО-хо! Суперлюкс!\n<PAGE>\nСегодня это ванна с какао. Густое тепло окутает\nтебя, а горько-сладкий аромат пощекочет нос!"
  },
  {
   "n": 22,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_02_000",
   "key": "5d38ce15",
   "ru": "<NAME_MOB_MUTSU>\r\nО-хо! Суперлюкс!\n<PAGE>\nСегодня ванна с сисо. Её аромат успокоит\nсердце..."
  },
  {
   "n": 23,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_03_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 24,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_04_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 25,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_05_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 26,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_06_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 27,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_07_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 28,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_08_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 29,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_09_000",
   "key": "72843a21",
   "ru": "Второй такой купели нет!"
  },
  {
   "n": 30,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_006",
   "key": "a2793ec5",
   "ru": "<NAME_MOB_MUTSU>\r\nЧтобы прочувствовать купель, понадобится <BLUE><MOJI0>\n<MOJI1> <MOJI2> <MOJI3></BLUE>. Хорошо?"
  },
  {
   "n": 31,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_007",
   "key": "14d8b000",
   "ru": "Звучит отлично"
  },
  {
   "n": 32,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_008",
   "key": "9f3d57d5",
   "ru": "<CANCEL_SELECT>\r\nНет, спасибо"
  },
  {
   "n": 33,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_HIGH_001",
   "key": "3a86e786",
   "ru": "Вся купель пропитана ароматом кипариса.\n<PAGE>\nГорячая вода прямо из источника ― чудесно!"
  },
  {
   "n": 34,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_MIDDLE_001",
   "key": "c3113826",
   "ru": "В горячей воде витают успокаивающие\nароматы. А-а-ах... блаженство..."
  },
  {
   "n": 35,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_LOW_001",
   "key": "feeb2fe9",
   "ru": "Горячая вода словно очищает тело и душу. Как\nспокойно..."
  },
  {
   "n": 36,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_00_001",
   "key": "148abf24",
   "ru": "В воздухе витает горько-сладкий аромат\nкакао...\n<PAGE>\nТягучая сладость проникает в каждую пору,\nкожа расслабляется, мышцы отдыхают."
  },
  {
   "n": 37,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_01_001",
   "key": "5c73e128",
   "ru": "В воздухе витает сладкий фруктовый аромат\nвина...\n<PAGE>\nТело согревается и снаружи, и изнутри!"
  },
  {
   "n": 38,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_02_001",
   "key": "dcb0d63b",
   "ru": "В воздухе витает свежий аромат сисо...\n<PAGE>\nПрилив бодрости!"
  },
  {
   "n": 39,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_03_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 40,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_04_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 41,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_05_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 42,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_06_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 43,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_07_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 44,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_08_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 45,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_IN_COLLABO_09_001",
   "key": "871b29f5",
   "ru": "Какая бодрящая ванна!"
  },
  {
   "n": 46,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GOODBYE_000",
   "key": "6fff2f5d",
   "ru": "<NAME_MOB_MUTSU>\r\nСпасибо за визит. Приходи ещё!"
  },
  {
   "n": 47,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_GOODBYE_001",
   "key": "e4f89b42",
   "ru": "<NAME_MOB_MUTSU>\r\nВид у тебя куда свежее и бодрее. Спасибо за\nвизит. Приходи скорее!"
  },
  {
   "n": 48,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_NOMONEY_000",
   "key": "c3c5ae24",
   "ru": "<NAME_MOB_MUTSU>\r\nПрости, но денег недостаточно."
  },
  {
   "n": 49,
   "f": 2,
   "id": "MSG_SHOP_J_SPA_HOUR",
   "key": "5c6dc2da",
   "ru": "ч"
  },
