   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "7ccc1de6",
   "ru": "А-а-ай! ...Я н-не боюсь!"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "6d3a9f93",
   "ru": "Зачем ты здесь в такую погоду?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "b3f69901",
   "ru": "Я сейчас не в духе."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "b724ec7f",
   "ru": "Уходи."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "b485eae5",
   "ru": "Я так зла."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "2b71f6ee",
   "ru": "Я сегодня такая счастливая. ♪"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "2cce56ed",
   "ru": "Эй! А ну иди сюда. ♪"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "1e070672",
   "ru": "Я вся горю! ♪"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "07c5af66",
   "ru": "Поиграй со мной!"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "89e23f11",
   "ru": "Что? Как же ты шумишь."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "1ae17237",
   "ru": "*ЗЕВАЕТ* Ну и энергичный же ты человек."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "8bd65527",
   "ru": "Наложить на тебя заклятье?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "d254024e",
   "ru": "Тебе, видно, нечем заняться."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "ed80b30a",
   "ru": "Будешь моей прислугой, понятно?!"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "51e17235",
   "ru": "Трудишься усерднее, чем я думала."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "b89e8c75",
   "ru": "Как насчёт чего-нибудь сладкого?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "c8549e71",
   "ru": "Ты не видишь мою лягушку?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "c3307215",
   "ru": "Хочу чего-нибудь весёлого."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "07c5af66",
   "ru": "Поиграй со мной!"
  }
 ]
