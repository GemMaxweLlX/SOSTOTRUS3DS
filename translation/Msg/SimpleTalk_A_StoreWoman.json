{
 "file": "SimpleTalk_A_StoreWoman",
 "entries": [
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "a5854347",
   "ru": "Ты ко мне поговорить?"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "1862b7e0",
   "ru": "Ого, ну и ветер!"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "52bbdd85",
   "ru": "На улице ужасно холодно, правда?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "919bad47",
   "ru": "*охает* Мне нехорошо."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "8053faa2",
   "ru": "Видно, я сегодня переутомилась."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "69630f49",
   "ru": "Кажется, мне нужен отдых."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "1ceaca8f",
   "ru": "Хочется петь! ♪"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "52a538ea",
   "ru": "Голос в идеальной форме!"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "c36f57c9",
   "ru": "Мне сегодня так хорошо."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "288129d1",
   "ru": "Будем смотреть на светлую сторону!"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "597e7f30",
   "ru": "Сегодня снова много дел. Как обычно."
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "3ea65910",
   "ru": "Есть не хочешь?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "931ec8b1",
   "ru": "Иди сюда. Давай поболтаем."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "0a581df1",
   "ru": "А-ха-ха! Ну и бодрый же ты человек!"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "333a1d67",
   "ru": "Путь к моему сердцу лежит через желудок!"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "bed518f3",
   "ru": "Ты всегда улыбаешься! Это так приятно."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "9b5249c7",
   "ru": "Споём вместе?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "7919bfc4",
   "ru": "Хочешь чего-нибудь вкусненького?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "bbc6fcdd",
   "ru": "Что такое? Тебе что-то нужно?"
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "84c28283",
   "ru": "О, кажется, я тебя раньше не видела."
  }
 ]
}
