{
 "file": "SimpleTalk_J_FarmOldwoman",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "9d69505f",
   "ru": "Ох. На улице ведь опасно?"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "c8e1658d",
   "ru": "Батюшки. Тебе не холодно?"
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "63b5a713",
   "ru": "Простите..."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "8048b9c2",
   "ru": "Уф... Немного устала."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "f21b9bc3",
   "ru": "Мне сегодня нездоровится..."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "711a7eff",
   "ru": "Для разнообразия мне хорошо."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "62c20b1e",
   "ru": "Сегодня я хорошо себя чувствую."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "b00c7850",
   "ru": "Может, даже попробую сделать зарядку."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "5e640f2b",
   "ru": "Ох, похоже, тебе весело."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "38011817",
   "ru": "Осторожнее на улице, хорошо?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "70c6a52a",
   "ru": "Не перетруждайся."
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "056bfd83",
   "ru": "Похоже, у тебя сейчас много дел."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "cf0397fd",
   "ru": "Смотри не споткнись, хорошо?"
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "524c8fac",
   "ru": "О, ты ко мне?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "60e8d629",
   "ru": "Важно заботиться о себе."
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "8d319075",
   "ru": "Ох. Ну что ж..."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "6b555f82",
   "ru": "Трудишься на ферме, да?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "486e61a3",
   "ru": "Бодрость ― это хорошо."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "bc05b1dc",
   "ru": "Ох, а ты кто будешь?"
  }
 ]
}
