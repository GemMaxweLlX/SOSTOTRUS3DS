{
 "file": "SimpleTalk_A_FarmOldwoman",
 "entries": [
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "f1603bbe",
   "ru": "В такую погоду на улицу? Ты что?!"
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "1ad6a952",
   "ru": "Похоже, снег ещё долго не кончится."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "9f499c3c",
   "ru": "Умаялась я."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "1a69bf0c",
   "ru": "Не люблю я старость, скажу тебе."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "843cb2fd",
   "ru": "Ох, опять спина разыгралась..."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "85e4179c",
   "ru": "Надо же, сегодня мне и правда хорошо."
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "5e62f962",
   "ru": "Сегодня будет хороший день."
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "b546e10e",
   "ru": "Гляди-ка. Витамины, видно, помогли."
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "862a06a4",
   "ru": "Горжусь, как ты трудишься."
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "63b6493b",
   "ru": "Как твои поля?"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "e4846f58",
   "ru": "Трудишься не покладая рук, а?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "724fbd9e",
   "ru": "Спортивная ходьба ― вот что нужно."
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "bf655b57",
   "ru": "Если устанешь, обязательно передохни."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "d60c6cd9",
   "ru": "Не перетруждайся."
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "415e9b48",
   "ru": "Часто готовишь?"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "1654c699",
   "ru": "Рыба? Спасибо, не надо."
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "1d1defa7",
   "ru": "Ты в порядке?"
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "b7af4fb9",
   "ru": "Бодрый вид, как всегда."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "eb1eb3c7",
   "ru": "Горжусь, как ты трудишься."
  }
 ]
}
