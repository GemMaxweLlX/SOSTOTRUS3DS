{
 "file": "SimpleTalk_S_TwinOlder",
 "entries": [
  {
   "n": 0,
   "f": 2,
   "id": "MES_SIMPLETALK_SICK",
   "key": "2d4c16d5",
   "ru": "Мне ужасно."
  },
  {
   "n": 1,
   "f": 2,
   "id": "MES_SIMPLETALK_SHOP",
   "key": "1cf8d393",
   "ru": "Комо май! Добро пожаловать! ♪"
  },
  {
   "n": 2,
   "f": 2,
   "id": "MES_SIMPLETALK_TYPHOON",
   "key": "f1776f31",
   "ru": "Сегодня сиди дома."
  },
  {
   "n": 3,
   "f": 2,
   "id": "MES_SIMPLETALK_HEAVYSNOW",
   "key": "4bd81709",
   "ru": "Тебя унесёт ветром."
  },
  {
   "n": 4,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_00",
   "key": "f1c85bb5",
   "ru": "Оставь меня в покое."
  },
  {
   "n": 5,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_01",
   "key": "88680e40",
   "ru": "*вздох* Я устала."
  },
  {
   "n": 6,
   "f": 2,
   "id": "MES_SIMPLETALK_TIRED_02",
   "key": "b3ab904c",
   "ru": "У меня болит голова."
  },
  {
   "n": 7,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_00",
   "key": "605c0fe4",
   "ru": "А, это ты. Алоха. ♪"
  },
  {
   "n": 8,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_01",
   "key": "dc418da1",
   "ru": "Надо же, <_____MYNAME_____>! ♪"
  },
  {
   "n": 9,
   "f": 2,
   "id": "MES_SIMPLETALK_GOOD_02",
   "key": "64f58516",
   "ru": "Хе-хе-хе! Мне хорошо. ♪"
  },
  {
   "n": 10,
   "f": 2,
   "id": "MES_SIMPLETALK_00",
   "key": "a1318e73",
   "ru": "Хочешь со мной поговорить?"
  },
  {
   "n": 11,
   "f": 2,
   "id": "MES_SIMPLETALK_01",
   "key": "ceb45666",
   "ru": "Кто сейчас присматривает за фермой? Никто?!"
  },
  {
   "n": 12,
   "f": 2,
   "id": "MES_SIMPLETALK_02",
   "key": "6bb916f2",
   "ru": "Хочешь узнать погоду? Опять?"
  },
  {
   "n": 13,
   "f": 2,
   "id": "MES_SIMPLETALK_03",
   "key": "8fb5e926",
   "ru": "Вам что-то нужно?"
  },
  {
   "n": 14,
   "f": 2,
   "id": "MES_SIMPLETALK_04",
   "key": "2293fdd7",
   "ru": "Что такое? Хлопот у тебя как у пчёлки."
  },
  {
   "n": 15,
   "f": 2,
   "id": "MES_SIMPLETALK_05",
   "key": "bf753f99",
   "ru": "Тебе разве нечем заняться?"
  },
  {
   "n": 16,
   "f": 2,
   "id": "MES_SIMPLETALK_06",
   "key": "cfd02726",
   "ru": "Есть свободное время ― давай поболтаем!"
  },
  {
   "n": 17,
   "f": 2,
   "id": "MES_SIMPLETALK_07",
   "key": "cfbb4ae7",
   "ru": "Бездельничаешь? А как же ферма?"
  },
  {
   "n": 18,
   "f": 2,
   "id": "MES_SIMPLETALK_08",
   "key": "5ef3305a",
   "ru": "Не споткнись и не упади при всех."
  },
  {
   "n": 19,
   "f": 2,
   "id": "MES_SIMPLETALK_09",
   "key": "293c0f7a",
   "ru": "Пожалуй, пора передохнуть."
  },
  {
   "n": 20,
   "f": 2,
   "id": "MES_SIMPLETALK_FIRST",
   "key": "da8acf5e",
   "ru": "Хочешь со мной поговорить?"
  }
 ]
}
